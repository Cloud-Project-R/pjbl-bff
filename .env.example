# Copie este arquivo para ".env" (na pasta pjbl-bff) e preencha.
# O ".env" NUNCA vai para o GitHub.

# Endereços dos microserviços (sem barra no final)
SALAS_URL=http://localhost:3001
RESERVAS_URL=http://localhost:3002

# Azure Function: endereço com /api no final e a chave de função (portal: Function App > App keys)
FUNCTION_URL=https://func-pjbl-notificacoes.azurewebsites.net/api
FUNCTION_KEY=

# Porta local (na nuvem/Docker o padrão é 3000)
PORT=3000

# Liga o CORS só para testes locais. Na nuvem o CORS fica no API Gateway.
ENABLE_CORS=true
